CONFIG_IDF_TARGET="esp32p4"
CONFIG_USBIP_BOARD_P4HIL_BOARD=y
CONFIG_USBIP_TRANSPORT_ETHERNET=y

# On P4, USB Serial/JTAG console does not conflict with USB host mode.
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_USBIP_VIRTUAL_LOGIC_ANALYZER=y

CONFIG_USBIP_ETH_MDC_GPIO=53
CONFIG_USBIP_ETH_MDIO_GPIO=54
CONFIG_USBIP_ETH_PHY_ADDR=1
CONFIG_USBIP_ETH_PHY_RST_GPIO=52

CONFIG_USB_HOST_HUBS_SUPPORTED=y

# Large composite devices.  esp-usb reads the whole configuration descriptor through the per-device control
# buffer, so a device whose wTotalLength exceeds it never enumerates: the port is enabled, then disabled.  The
# default 256 rejected a Jumperless V5 (five CDC functions + MSC, ~360 bytes).  Its interface/endpoint count
# (11 / 17) also overran the export tables, which silently drop what does not fit.
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1024
CONFIG_USBIP_MAX_INTERFACES=16
CONFIG_USBIP_MAX_ENDPOINTS=32


# The HTTP API serves one request at a time; connections wait in the accept
# mailbox meanwhile (a console peek holds it up to 12 s).  At the default 6,
# a browser's pollers overflowed it and lwIP reset the extra connections.
CONFIG_LWIP_TCP_ACCEPTMBOX_SIZE=12
